# Copier en .env (jamais commité) et remplir.
# Les variables d'environnement, si elles existent, priment sur ce fichier.

# Adresse du dashboard mcp-memory-service (web/app.py).
# Phase 1 : le dashboard local lancé par start-memory-rest.ps1.
MEMOIRE_API_URL=http://127.0.0.1:8000

# Clé attendue par le dashboard : même valeur que MCP_API_KEY côté serveur.
MEMOIRE_API_KEY=

# Phase 2 seulement, si le tunnel Cloudflare est lui-même protégé par
# Cloudflare Access : jeton de service (Zero Trust → Access → Service Auth).
# MEMOIRE_CF_ACCESS_CLIENT_ID=
# MEMOIRE_CF_ACCESS_CLIENT_SECRET=
